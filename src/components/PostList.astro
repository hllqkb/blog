---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/site';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <a href={url(`/posts/${p.id}/`)}>{p.data.title}</a>
      <div class="meta">
        <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        {p.data.draft && <span> · 草稿</span>}
      </div>
      {p.data.description && <p>{p.data.description}</p>}
    </li>
  ))}
</ul>
