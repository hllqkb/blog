---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, description, tags, cover, source_url } = post.data;
---
<Base title={title} description={description} canonical={source_url} nav="posts">
  <article class="post">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tags.length > 0 && <span> · {tags.map((t) => <a class="tag" href={url(`/tags/${encodeURIComponent(t)}/`)}>{t}</a>)}</span>}
      </div>
      {source_url && <p class="notice">转载文章，原文：<a href={source_url}>{source_url}</a></p>}
    </header>
    {cover && <img src={cover} alt="" />}
    <div class="prose"><Content /></div>
  </article>
  <nav class="post-nav" aria-label="上一篇和下一篇">
    <span>{older && <a href={url(`/posts/${older.id}/`)}>← {older.data.title}</a>}</span>
    <span>{newer && <a href={url(`/posts/${newer.id}/`)}>{newer.data.title} →</a>}</span>
  </nav>
</Base>
