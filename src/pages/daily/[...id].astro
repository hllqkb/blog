---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dailyIssues, url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await dailyIssues();
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue } }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);
---
<Base title={issue.data.title} description={issue.data.subtitle} nav="daily">
  <article class="post">
    <header>
      <h1>{issue.data.title}</h1>
      <div class="meta"><time datetime={issue.data.date.toISOString()}>{formatDate(issue.data.date)}</time> · <a href={url('/daily/')}>往期</a></div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
